{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storefront-skeleton",
  "main": "apps/api/src/index.js",
  "compatibility_date": "2026-11-12",
  "assets": {
    "directory": "apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*",
      "/account",
      "/account/*",
      "/cart",
      "/cart/*",
      "/staff",
      "/staff/*",
      "/products/*",
      "/media/*",
      "/sitemap.xml",
      "/robots.txt"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storefront-skeleton",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "storefront-skeleton-media"
    }
  ],
  "vars": {
    "APP_ENV": "development",
    "CF_ACCESS_TEAM_NAME": "",
    "CF_ACCESS_AUD": ""
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "env": {
    "staging": {
      "name": "storefront-skeleton-staging",
      "workers_dev": false,
      "preview_urls": false,
      "triggers": {
        "crons": []
      },
      "assets": {
        "directory": "apps/web/dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "storefront-skeleton-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "APP_ENV": "staging",
        "OIDC_REDIRECT_ORIGINS": "https://staging.example.com",
        "STAFF_OIDC_REDIRECT_ORIGINS": "https://staging.example.com",
        "ADMIN_HOST": "staging.example.com",
        "CF_ACCESS_TEAM_NAME": "",
        "CF_ACCESS_AUD": "",
        "GOOGLE_CLIENT_ID": ""
      }
    }
  }
}
